# ===========================================
# 🔐 安全警告 🔐
# ===========================================
# 1. 此文件为示例配置，严禁直接部署
# 2. 所有密钥必须使用 `openssl rand -base64 32` 生成
# 3. 生产环境建议使用 Vault / AWS Secrets Manager 管理密钥
# 4. 定期轮换密钥（建议每 90 天）
# 5. 不要将真实密钥提交到版本控制系统
# ===========================================

# ===========================================
# 数据库配置 (Supabase / Neon / Railway)
# ===========================================
# ⚠️ 必须替换为实际数据库连接字符串
DATABASE_URL="postgresql://user:password@host:5432/solo_sales?sslmode=require"

# ===========================================
# Better Auth 认证配置
# ===========================================
# ⚠️ 必须替换为生产环境实际 URL
BETTER_AUTH_URL="https://your-production-domain.com"

# ⚠️ 必须替换为随机生成的密钥 (32字节Base64)
# 生成命令: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_TO_32BYTE_BASE64_STRING"

# ===========================================
# Stripe 支付配置
# ===========================================
# ⚠️ 必须替换为生产密钥
STRIPE_PUBLIC_KEY="pk_test_REPLACE_WITH_YOUR_STRIPE_PUBLIC_KEY"
STRIPE_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY"

# ===========================================
# PayPal 支付配置
# ===========================================
# ⚠️ 必须替换为生产密钥
PAYPAL_CLIENT_ID="PRODUCTION-CLIENT-ID"
PAYPAL_CLIENT_SECRET="PRODUCTION-CLIENT-SECRET"

# ===========================================
# Redis 缓存配置 (Upstash)
# ===========================================
# ⚠️ 必须替换为实际 Upstash 配置
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxx"

# ===========================================
# Sentry 错误监控 (可选)
# ===========================================
# ⚠️ 如果使用 Sentry，替换为实际 DSN
SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"


# AI CustomerService integration
AI_CUSTOMER_ENABLED=false
AI_CUSTOMER_BASE_URL=http://127.0.0.1:8001
AI_CUSTOMER_SERVICE_TOKEN=change-me-service-token
AI_CUSTOMER_HMAC_SECRET=change-me-hmac-secret
AI_CUSTOMER_TIMEOUT_MS=5000
AI_CUSTOMER_TENANT_ID=solo-sales
AI_CUSTOMER_LOCALE=zh-CN
