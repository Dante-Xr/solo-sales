# SoloSales 生产环境变量配置示例
# 复制此文件为 .env.production 并填写实际值

# ===========================================
# 数据库配置 (Supabase / Neon / Railway)
# ===========================================
DATABASE_URL="postgresql://user:password@host:5432/solo_sales?sslmode=require"

# ===========================================
# NextAuth 认证配置
# ===========================================
# 生产环境 URL (Vercel 部署后会分配域名)
NEXTAUTH_URL="https://your-app.vercel.app"

# 密钥 (生成命令: openssl rand -base64 32)
NEXTAUTH_SECRET="your-generated-secret-key-here"

# ===========================================
# Stripe 支付配置
# ===========================================
# 测试密钥 (开发环境)
STRIPE_PUBLIC_KEY="pk_test_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"

# 生产密钥 (部署后替换)
# STRIPE_PUBLIC_KEY="pk_live_xxx"
# STRIPE_SECRET_KEY="sk_live_xxx"

# ===========================================
# PayPal 支付配置
# ===========================================
# 测试环境
PAYPAL_CLIENT_ID="xxx"
PAYPAL_CLIENT_SECRET="xxx"

# 生产环境 (部署后替换)
# PAYPAL_CLIENT_ID="production-client-id"
# PAYPAL_CLIENT_SECRET="production-client-secret"

# ===========================================
# 应用配置
# ===========================================
# NODE_ENV=production

# ===========================================
# Redis 缓存配置 (Upstash)
# ===========================================
# 注册 https://upstash.com 获取以下配置
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"
