// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户模型 (包括普通用户和管理员)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // v0.5.9 添加登录安全字段
  failedLoginAttempts  Int       @default(0)   // 连续登录失败次数
  lockoutUntil        DateTime?              // 账户锁定截止时间
  lastLoginAt         DateTime?              // 最后登录时间
  lastLoginIp         String?                // 最后登录 IP

  orders        Order[]
  messages      Message[]
  reviews       Review[]
  customerPoints CustomerPoints?
}

enum UserRole {
  USER
  ADMIN
}

// 商品类别
model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 商品模型
model Product {
  id          String      @id @default(cuid())
  sku         String?     @unique // 商品 SKU，用于批发导入去重
  name        String
  description String
  price       Decimal     @db.Decimal(10, 2) // 使用 Decimal 避免浮点数精度问题
  stock       Int         @default(0)
  images      String[]
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  isPublished Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orderItems  OrderItem[]
  reviews     Review[]
  stockAlert  StockAlert?

  // v0.4.3 添加数据库索引 - 优化高频查询性能
  @@index([categoryId])          // 按分类查商品
  @@index([isPublished])        // 筛选已发布商品
  @@index([name])               // 按名称搜索优化
  @@index([categoryId, isPublished, createdAt]) // 复合索引：分类+发布状态+时间
}

// 订单模型
model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Decimal     @db.Decimal(10, 2) // 使用 Decimal 避免浮点数精度问题
  status      OrderStatus @default(PENDING)
  paymentMethod String?
  shippingAddress String?
  trackingNumber String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]
  payments    Payment[]
  couponUsages CouponUsage[]

  // v0.4.3 添加数据库索引 - 优化订单查询性能
  @@index([userId])              // 按用户查订单
  @@index([status])              // 按状态筛选订单
  @@index([createdAt])           // 按时间排序查询
  @@index([userId, status])      // 复合索引：用户+状态
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// 订单商品明细
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(10, 2) // 使用 Decimal 避免浮点数精度问题
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 支付记录
model Payment {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  amount        Decimal  @db.Decimal(10, 2) // 使用 Decimal 避免浮点数精度问题
  currency      String   @default("USD")
  status        PaymentStatus @default(PENDING)
  provider      String
  transactionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // v0.4.3 添加数据库索引 - 优化支付查询性能
  @@index([orderId])              // 按订单查支付记录
  @@index([transactionId])         // 按支付流水号查询
  @@index([status])               // 按状态筛选
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// 客服消息系统
model Message {
  id        String   @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  content   String
  isFromAdmin Boolean @default(false)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // v0.4.3 添加数据库索引 - 优化消息查询
  @@index([userId])               // 按用户查消息
  @@index([isRead])               // 筛选未读消息
}

// ============================================
// RAG 知识库模块 (Task 1.1)
// 用于存储和管理智能客服所需的各类素材
// 支持知识库内容的创建、编辑、分类、检索和版本控制
// ============================================

// 知识库分类模型 - 支持多级分类结构
model KnowledgeCategory {
  id       String  @id @default(cuid())
  name     String  // 分类名称
  parentId String? // 父分类 ID，支持多级分类
  order    Int     @default(0) // 排序权重
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联该分类下的所有知识条目
  articles KnowledgeBase[]

  // 自引用：父分类
  parent   KnowledgeCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  // 自引用：子分类
  children KnowledgeCategory[] @relation("CategoryHierarchy")
}

// 知识库条目模型 - 存储智能客服所需的知识内容
model KnowledgeBase {
  id        String   @id @default(cuid())
  title     String   // 知识条目标题
  content   String   // 知识条目内容（支持富文本）
  category  String   // 所属分类名称
  tags      String[] // 标签数组，用于检索和推荐
  version   Int      @default(1) // 版本号，更新时自动递增
  status    KnowledgeStatus @default(DRAFT) // 状态：草稿/已发布/已归档
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   // 创建者 ID

  // 关联分类
  categoryRelation KnowledgeCategory? @relation(fields: [category], references: [id])

  // 版本历史记录
  history   KnowledgeHistory[]
}

// 知识库状态枚举
enum KnowledgeStatus {
  DRAFT    // 草稿
  PUBLISHED // 已发布
  ARCHIVED // 已归档
}

// 知识库历史版本模型 - 记录每次修改的历史
model KnowledgeHistory {
  id          String   @id @default(cuid())
  knowledgeId String   // 对应的知识条目 ID
  version     Int      // 版本号
  title       String   // 修改时的标题
  content     String   // 修改时的内容
  changedAt   DateTime @default(now())
  changedBy   String   // 修改者 ID

  // 关联知识条目
  knowledge   KnowledgeBase @relation(fields: [knowledgeId], references: [id])
}

// ============================================
// 批发网站 API 对接模块 (Task 1.1)
// 用于存储批发商品导入记录和日志
// ============================================

// 批发商品导入日志模型
model ImportLog {
  id            String   @id @default(cuid())
  wholesaler    String   // 批发商名称 (如: 1866)
  status        ImportStatus @default(PENDING) // 导入状态
  totalProducts Int      @default(0) // 总商品数
  successCount  Int      @default(0) // 成功数
  failCount     Int      @default(0) // 失败数
  errorDetails  String[] // 错误详情数组
  startedAt     DateTime @default(now())
  completedAt   DateTime? // 完成时间
  triggeredBy   String   // 触发者 ID
}

// 导入状态枚举
enum ImportStatus {
  PENDING   // 待处理
  RUNNING   // 运行中
  COMPLETED // 已完成
  FAILED    // 失败
}

// ============================================
// 后台管理员权限管理模块
// 支持细粒度的权限控制和角色管理
// ============================================

// 权限模型 - 定义系统中的所有权限
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // 权限标识 (如: products.view)
  label       String   // 显示名称 (如: 查看商品)
  description String?  // 权限描述
  type        PermissionType @default(ACTION) // 权限类型: 页面权限 / 操作权限
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联角色
  roles       Role[]   @relation("RolePermissions")
}

// 权限类型枚举
enum PermissionType {
  PAGE    // 页面权限
  ACTION  // 操作权限
  DATA    // 数据权限
}

// 角色模型 - 关联权限集合
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // 角色标识 (如: admin, operator)
  label       String   // 显示名称 (如: 管理员，运营员)
  description String?  // 角色描述
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联权限
  permissions Permission[] @relation("RolePermissions")

  // 关联管理员用户
  admins      AdminUser[]
}

// 管理员用户模型 - 后台管理系统用户
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique // 用户名 (唯一)
  email        String   @unique // 邮箱 (唯一)
  password     String   // 加密密码
  roleId       String   // 关联角色 ID
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true) // 是否启用
  lastLoginAt  DateTime? // 最后登录时间
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 关联操作日志
  permissionLogs PermissionLog[]

  // v0.4.3 添加数据库索引 - 优化管理员查询
  @@index([roleId])               // 按角色查管理员
  @@index([isActive])             // 筛选启用的管理员
}

// ============================================
// 商品评价模块 (v0.5.0)
// 用于用户对商品进行评价和评分
// ============================================

// 商品评价模型
model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  rating      Int      // 1-5 星评分
  title       String?  // 评价标题
  content     String?  // 评价内容
  images      ReviewImage[]
  replies     ReviewReply[]
  isApproved  Boolean  @default(false)  // 是否审核通过
  isFeatured  Boolean  @default(false)  // 是否精选
  helpfulCount Int     @default(0)      // 点赞数
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联关系
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // v0.5.0 添加数据库索引 - 优化评价查询
  @@index([productId])              // 按商品查评价
  @@index([userId])                // 按用户查评价
  @@index([rating])                // 按评分筛选
  @@index([isApproved])            // 筛选已审核
  @@index([createdAt])             // 按时间排序
}

// 评价图片模型
model ReviewImage {
  id        String  @id @default(cuid())
  reviewId  String
  url       String  // 图片 URL
  position  Int     @default(0)  // 图片顺序

  review    Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])              // 按评价查图片
}

// 评价回复模型 (支持商家回复)
model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String?  // 回复用户 ID (可为 null 表示商家回复)
  adminId   String?  // 管理员 ID (商家回复)
  content   String   // 回复内容
  createdAt DateTime @default(now())

  review    Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])              // 按评价查回复
}

// ============================================
// 权限变更日志模块
// 用于审计追踪权限、角色、用户的变更记录
// ============================================

// 日志操作类型枚举
enum LogAction {
  CREATE // 创建
  UPDATE // 更新
  DELETE // 删除
}

// 日志目标类型枚举
enum TargetType {
  PERMISSION // 权限
  ROLE       // 角色
  ADMIN_USER // 管理员用户
}

// 权限变更日志模型
model PermissionLog {
  id          String    @id @default(cuid())
  action      LogAction // 操作类型
  targetType  TargetType // 目标类型
  targetId    String    // 目标 ID
  operatorId  String    // 操作人 ID
  beforeData  Json?     // 变更前数据
  afterData   Json?     // 变更后数据
  ipAddress   String?   // IP 地址
  userAgent   String?   // 用户代理
  createdAt   DateTime  @default(now())

  // 关联操作人
  operator    AdminUser @relation(fields: [operatorId], references: [id])
}

// ============================================
// 优惠券模块 (v0.5.5)
// ============================================

// 优惠券类型枚举
enum CouponType {
  PERCENTAGE  // 百分比折扣 (如: 20% off)
  FIXED       // 固定金额折扣 (如: $10 off)
}

// 优惠券模型
model Coupon {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  description   String?
  type          CouponType
  value         Decimal     @db.Decimal(10, 2) // 折扣值或百分比
  minAmount     Decimal?    @db.Decimal(10, 2) // 最低消费金额
  maxDiscount   Decimal?    @db.Decimal(10, 2) // 最高折扣金额
  maxUses       Int?        // 最大使用次数
  usedCount     Int         @default(0)
  perUserLimit  Int         @default(1)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  usages        CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
}

// 优惠券使用记录模型
model CouponUsage {
  id          String   @id @default(cuid())
  couponId    String
  userId      String
  orderId     String
  discount    Decimal  @db.Decimal(10, 2) // 实际折扣金额
  usedAt      DateTime @default(now())

  coupon      Coupon   @relation(fields: [couponId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id])

  @@unique([couponId, userId]) // 防止重复使用
  @@index([couponId])
  @@index([userId])
}

// ============================================
// 会员积分模块 (v0.5.5)
// ============================================

// 会员等级枚举
enum MemberTier {
  BRONZE     // 青铜
  SILVER     // 白银
  GOLD       // 黄金
  PLATINUM   // 白金
}

// 积分类型枚举
enum PointType {
  EARN       // 消费获得
  REDEEM     // 兑换抵扣
  BONUS      // 奖励
  EXPIRE     // 过期作废
  ADJUST     // 后台调整
  REFUND     // 退款扣回
}

// 积分计划模型
model LoyaltyProgram {
  id            String   @id @default(cuid())
  name          String   @default("默认积分计划")
  pointsRate    Float    @default(1.0)  // 每消费1元得积分
  pointsToYuan  Float    @default(0.01) // 100积分=1元
  minRedemption Int      @default(100) // 最低兑换积分
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 客户积分模型
model CustomerPoints {
  id            String      @id @default(cuid())
  userId        String      @unique
  balance       Int         @default(0)
  totalEarned   Int         @default(0)
  totalRedeemed Int         @default(0)
  tier          MemberTier  @default(BRONZE)
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  transactions  PointTransaction[]

  @@index([userId])
}

// 积分交易记录模型
model PointTransaction {
  id                String       @id @default(cuid())
  customerPointsId  String
  userId            String
  amount            Int          // 正数=获得，负数=消耗
  type              PointType
  orderId           String?
  description        String
  expiresAt          DateTime?    // 积分过期时间
  createdAt         DateTime     @default(now())

  customerPoints     CustomerPoints @relation(fields: [customerPointsId], references: [id])

  @@index([userId])
  @@index([customerPointsId])
  @@index([type])
  @@index([expiresAt])
}

// ============================================
// 废弃购物车模块 (v0.5.8)
// 用于追踪废弃购物车并发送挽回邮件
// ============================================

// 废弃购物车状态枚举
enum AbandonedCartStatus {
  PENDING     // 待发送
  SENT        // 已发送第一封
  SENT_SECOND // 已发送第二封
  RECOVERED   // 已恢复（用户完成购买）
  EXPIRED     // 已过期（不再发送）
}

// 废弃购物车模型
model AbandonedCart {
  id            String               @id @default(cuid())
  userId        String
  userEmail     String
  userName      String?
  cartData      Json                 // 购物车内容
  totalAmount   Decimal              @db.Decimal(10, 2) // 使用 Decimal 避免浮点数精度问题
  locale        String               @default("en")
  status        AbandonedCartStatus  @default(PENDING)
  lastEmailAt   DateTime?
  emailCount    Int                  @default(0)
  recoveredAt   DateTime?            // 恢复购买时间
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt]) // 复合索引：状态+时间（废弃购物车查询）
  @@index([userId, status])   // 复合索引：用户+状态
}

// ============================================
// 库存预警模块 (v0.5.8)
// ============================================

// 库存预警配置模型
model StockAlert {
  id          String   @id @default(cuid())
  productId   String   @unique
  threshold   Int      @default(10)  // 预警阈值
  isEnabled   Boolean  @default(true)
  notifyEmails String[] // 通知邮箱列表
  lastAlertAt DateTime?

  product     Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([isEnabled])
}

// 库存预警日志模型
model StockAlertLog {
  id          String   @id @default(cuid())
  productId   String
  productName String
  oldStock    Int
  newStock    Int
  threshold   Int
  notifiedEmails String[]
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}
