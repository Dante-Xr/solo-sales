// 修改内容：新增 BackgroundJob 后台任务模型与枚举，支撑导入、分析、webhook 后处理和通知类重任务的异步化准备。
// 修改模型：gpt-5.5
//
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders         Order[]
  messages       Message[]
  reviews        Review[]
  customerPoints CustomerPoints?
  affiliate      Affiliate?
  banned         Boolean?        @default(false)
  banReason      String?
  banExpires     DateTime?
  sessions       Session[]
  accounts       Account[]
  adminProfile   AdminUser?

  @@map("user")
}

// 商品类别

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 商品模型

model Product {
  id          String    @id @default(cuid())
  sku         String?   @unique // 商品 SKU，用于批发导入去重
  name        String
  description String
  price       Decimal   @db.Decimal(10, 2) // 使用 Decimal 避免浮点数精度问题
  stock       Int       @default(0)
  images      String[]
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orderItems  OrderItem[]
  reviews     Review[]
  bundleItems BundleItem[]

  // v0.4.3 添加数据库索引 - 优化高频查询性能
  // 按分类查商品
  // 筛选已发布商品
  // 按名称搜索优化
  // 复合索引：分类+发布状态+时间
  @@index([categoryId])
  @@index([isPublished])
  @@index([name])
  @@index([categoryId, isPublished, createdAt])
}

// 订单模型

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  totalAmount     Decimal     @db.Decimal(10, 2) // 使用 Decimal 避免浮点数精度问题
  status          OrderStatus @default(PENDING)
  paymentMethod   String?
  shippingAddress String?
  trackingNumber  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items        OrderItem[]
  payments     Payment[]
  couponUsages CouponUsage[]
  currency     OrderCurrency?
  paymentProof PaymentProof? // v1.7.2 支付凭证关系

  // v0.4.3 添加数据库索引 - 优化订单查询性能
  // 按用户查订单
  // 按状态筛选订单
  // 按时间排序查询
  // 复合索引：用户+状态
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// 订单商品明细

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(10, 2) // 使用 Decimal 避免浮点数精度问题
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 支付记录

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Decimal       @db.Decimal(10, 2) // 使用 Decimal 避免浮点数精度问题
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  provider      String
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([provider, transactionId])
  // v0.4.3 添加数据库索引 - 优化支付查询性能
  // 按订单查支付记录
  // 按支付流水号查询
  // 按状态筛选
  @@index([orderId])
  @@index([transactionId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// 客服消息系统

model Message {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  content     String
  isFromAdmin Boolean  @default(false)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // v0.4.3 添加数据库索引 - 优化消息查询
  // 按用户查消息
  // 筛选未读消息
  @@index([userId])
  @@index([isRead])
}

// ============================================
// RAG 知识库模块 (Task 1.1)
// 用于存储和管理智能客服所需的各类素材
// 支持知识库内容的创建、编辑、分类、检索和版本控制
// ============================================

// 知识库分类模型 - 支持多级分类结构

model KnowledgeCategory {
  id        String   @id @default(cuid())
  name      String // 分类名称
  parentId  String? // 父分类 ID，支持多级分类
  order     Int      @default(0) // 排序权重
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联该分类下的所有知识条目
  articles KnowledgeBase[]

  // 自引用：父分类
  parent   KnowledgeCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  // 自引用：子分类
  children KnowledgeCategory[] @relation("CategoryHierarchy")
}

// 知识库条目模型 - 存储智能客服所需的知识内容

model KnowledgeBase {
  id        String          @id @default(cuid())
  title     String // 知识条目标题
  content   String // 知识条目内容（支持富文本）
  category  String // 所属分类名称
  tags      String[] // 标签数组，用于检索和推荐
  version   Int             @default(1) // 版本号，更新时自动递增
  status    KnowledgeStatus @default(DRAFT) // 状态：草稿/已发布/已归档
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  createdBy String // 创建者 ID

  // 关联分类
  categoryRelation KnowledgeCategory? @relation(fields: [category], references: [id])

  // 版本历史记录
  history KnowledgeHistory[]
}

// 知识库状态枚举

enum KnowledgeStatus {
  DRAFT // 草稿
  PUBLISHED // 已发布
  ARCHIVED // 已归档
}

// 知识库历史版本模型 - 记录每次修改的历史

model KnowledgeHistory {
  id          String   @id @default(cuid())
  knowledgeId String // 对应的知识条目 ID
  version     Int // 版本号
  title       String // 修改时的标题
  content     String // 修改时的内容
  changedAt   DateTime @default(now())
  changedBy   String // 修改者 ID

  // 关联知识条目
  knowledge KnowledgeBase @relation(fields: [knowledgeId], references: [id])
}

// ============================================
// 智能客服 RAG 模块 (v0.6.0)
// ============================================

// RAG 对话会话模型

model Conversation {
  id              String              @id @default(cuid())
  userId          String? // 用户 ID（可为空）
  userEmail       String? // 用户邮箱
  status          ConversationStatus  @default(ACTIVE) // 会话状态
  currentIntent   String? // 当前意图
  rating          SatisfactionRating? // 用户满意度
  feedbackComment String? // 用户反馈
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // 关联消息
  messages ChatMessage[]
}

// 会话状态枚举

enum ConversationStatus {
  ACTIVE // 进行中
  COMPLETED // 已完成
  EXPIRED // 已过期
  ESCALATED // 已转人工
}

// 满意度枚举

enum SatisfactionRating {
  SATISFIED // 满意
  NEUTRAL // 一般
  DISSATISFIED // 不满意
}

// RAG 聊天消息模型

model ChatMessage {
  id             String      @id @default(cuid())
  conversationId String // 关联的会话 ID
  role           MessageRole // 角色：用户/助手/系统
  content        String      @db.Text // 消息内容
  intent         String? // 识别的意图
  confidence     Float? // 置信度
  createdAt      DateTime    @default(now())

  // 关联会话
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
}

// 消息角色枚举

enum MessageRole {
  USER // 用户
  ASSISTANT // 助手
  SYSTEM // 系统
}

// ============================================
// 数据分析报表模块 (v0.6.0)
// ============================================

// 每日数据快照模型

model DailySnapshot {
  id                 String   @id @default(cuid())
  date               DateTime @db.Date // 日期（不含时间）
  totalRevenue       Decimal  @default(0) @db.Decimal(12, 2) // 总收入
  totalOrders        Int      @default(0) // 总订单数
  totalVisitors      Int      @default(0) // 访问人数
  newCustomers       Int      @default(0) // 新客户数
  returningCustomers Int      @default(0) // 回头客数
  avgOrderValue      Decimal  @default(0) @db.Decimal(10, 2) // 平均订单金额
  conversionRate     Decimal  @default(0) @db.Decimal(5, 4) // 转化率
  topProducts        Json? // 热销商品 [{"productId": "x", "count": 10}]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

// 报表定时任务模型

model ReportSchedule {
  id         String     @id @default(cuid())
  name       String // 任务名称
  type       ReportType // 报表类型
  cron       String // cron 表达式
  recipients String[] // 邮件接收者列表
  isActive   Boolean    @default(true) // 是否启用
  lastRun    DateTime? // 上次运行时间
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([isActive])
  @@index([type])
}

// 报表类型枚举

enum ReportType {
  DAILY_SALES // 日销售报表
  WEEKLY_SALES // 周销售报表
  MONTHLY_SALES // 月销售报表
  INVENTORY // 库存报表
  CUSTOMER_ANALYSIS // 客户分析报表
  PRODUCT_PERFORMANCE // 商品表现报表
}

// ============================================
// 批发网站 API 对接模块 (Task 1.1)
// 用于存储批发商品导入记录和日志
// ============================================

// 批发商品导入日志模型

model ImportLog {
  id            String       @id @default(cuid())
  wholesaler    String // 批发商名称 (如: 1866)
  status        ImportStatus @default(PENDING) // 导入状态
  totalProducts Int          @default(0) // 总商品数
  successCount  Int          @default(0) // 成功数
  failCount     Int          @default(0) // 失败数
  errorDetails  String[] // 错误详情数组
  startedAt     DateTime     @default(now())
  completedAt   DateTime? // 完成时间
  triggeredBy   String // 触发者 ID
}

// 导入状态枚举

enum ImportStatus {
  PENDING // 待处理
  RUNNING // 运行中
  COMPLETED // 已完成
  FAILED // 失败
}

// ============================================
// 后台重任务队列准备模块 (v1.5)
// 用于记录可重试、可恢复的导入、分析刷新、webhook 后处理和通知派发任务
// ============================================

model BackgroundJob {
  id            String              @id @default(cuid())
  type          BackgroundJobType
  status        BackgroundJobStatus @default(QUEUED)
  payload       Json
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(3)
  lastError     String?
  lockedAt      DateTime?
  lockToken     String?
  lockExpiresAt DateTime?
  availableAt   DateTime            @default(now())
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, availableAt])
  @@index([type, status])
  @@index([createdAt])
}

// Authentication email delivery is controlled by one persisted worker configuration.
// The lease is shared by scheduled, manual and emergency HTTP triggers.
model AuthEmailWorkerConfig {
  id                  String   @id
  enabled             Boolean  @default(false)
  intervalMinutes     Int      @default(5)
  batchSize           Int      @default(5)
  lastHeartbeatAt     DateTime?
  lastStartedAt       DateTime?
  lastCompletedAt     DateTime?
  leaseToken          String?
  leaseExpiresAt      DateTime?
  consecutiveFailures Int      @default(0)
  lastError           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  runs AuthEmailWorkerRun[]

  @@index([leaseExpiresAt])
  @@map("auth_email_worker_config")
}

model AuthEmailWorkerRun {
  id          String                    @id @default(cuid())
  configId    String
  config      AuthEmailWorkerConfig     @relation(fields: [configId], references: [id], onDelete: Cascade)
  trigger     AuthEmailWorkerRunTrigger
  status      AuthEmailWorkerRunStatus
  processed   Int                       @default(0)
  delivered   Int                       @default(0)
  deadLettered Int                      @default(0)
  error       String?
  initiatedById String?
  startedAt   DateTime                  @default(now())
  completedAt DateTime?

  @@index([configId, startedAt])
  @@index([startedAt])
  @@map("auth_email_worker_run")
}

enum AuthEmailWorkerRunTrigger {
  SCHEDULED
  MANUAL
  HTTP
}

enum AuthEmailWorkerRunStatus {
  SUCCEEDED
  SKIPPED
  FAILED
}

enum BackgroundJobType {
  WHOLESALER_IMPORT
  ANALYTICS_REFRESH
  STRIPE_WEBHOOK_POST_PROCESS
  NOTIFICATION_DISPATCH
  AUTH_EMAIL_DISPATCH
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  DEAD_LETTER
}

// ============================================
// 后台管理员权限管理模块
// 支持细粒度的权限控制和角色管理
// ============================================

// 权限模型 - 定义系统中的所有权限

model Permission {
  id          String         @id @default(cuid())
  name        String         @unique // 权限标识 (如: products.view)
  label       String // 显示名称 (如: 查看商品)
  description String? // 权限描述
  type        PermissionType @default(ACTION) // 权限类型: 页面权限 / 操作权限
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // 关联角色
  roles Role[] @relation("RolePermissions")
}

// 权限类型枚举

enum PermissionType {
  PAGE // 页面权限
  ACTION // 操作权限
  DATA // 数据权限
}

// 角色模型 - 关联权限集合

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // 角色标识 (如: admin, operator)
  label       String // 显示名称 (如: 管理员，运营员)
  description String? // 角色描述
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联权限
  permissions Permission[] @relation("RolePermissions")

  // 关联管理员用户
  admins AdminUser[]
}

// 管理员用户模型 - 后台管理系统用户

model AdminUser {
  id          String    @id @default(cuid())
  userId      String?   @unique // v1.8.0 staged identity link to Better Auth User
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String    @unique // 用户名 (唯一)
  email       String    @unique // 邮箱 (唯一)
  password    String? // v1.8.0 migration clears legacy credentials after Account ownership is established
  roleId      String // 关联角色 ID
  role        Role      @relation(fields: [roleId], references: [id])
  isActive    Boolean   @default(true) // 是否启用
  lastLoginAt DateTime? // 最后登录时间
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 关联操作日志
  permissionLogs PermissionLog[]

  // v0.4.3 添加数据库索引 - 优化管理员查询
  // 按角色查管理员
  // 筛选启用的管理员
  @@index([roleId])
  @@index([isActive])
}

// ============================================
// 商品评价模块 (v0.5.0)
// 用于用户对商品进行评价和评分
// ============================================

// 商品评价模型

model Review {
  id           String        @id @default(cuid())
  productId    String
  userId       String
  rating       Int // 1-5 星评分
  title        String? // 评价标题
  content      String? // 评价内容
  images       ReviewImage[]
  replies      ReviewReply[]
  isApproved   Boolean       @default(false) // 是否审核通过
  isFeatured   Boolean       @default(false) // 是否精选
  helpfulCount Int           @default(0) // 点赞数
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // 关联关系
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // v0.5.0 添加数据库索引 - 优化评价查询
  // 按商品查评价
  // 按用户查评价
  // 按评分筛选
  // 筛选已审核
  // 按时间排序
  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@index([isApproved])
  @@index([createdAt])
}

// 评价图片模型

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  url      String // 图片 URL
  position Int    @default(0) // 图片顺序

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  // 按评价查图片
  @@index([reviewId])
}

// 评价回复模型 (支持商家回复)

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String? // 回复用户 ID (可为 null 表示商家回复)
  adminId   String? // 管理员 ID (商家回复)
  content   String // 回复内容
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  // 按评价查回复
  @@index([reviewId])
}

// ============================================
// 权限变更日志模块
// 用于审计追踪权限、角色、用户的变更记录
// ============================================

// 日志操作类型枚举

enum LogAction {
  CREATE // 创建
  UPDATE // 更新
  DELETE // 删除
}

// 日志目标类型枚举

enum TargetType {
  PERMISSION // 权限
  ROLE // 角色
  ADMIN_USER // 管理员用户
  SYSTEM_CONFIG // 系统运行配置
}

// 权限变更日志模型

model PermissionLog {
  id         String     @id @default(cuid())
  action     LogAction // 操作类型
  targetType TargetType // 目标类型
  targetId   String // 目标 ID
  operatorId String // 操作人 ID
  beforeData Json? // 变更前数据
  afterData  Json? // 变更后数据
  ipAddress  String? // IP 地址
  userAgent  String? // 用户代理
  createdAt  DateTime   @default(now())

  // 关联操作人
  operator AdminUser @relation(fields: [operatorId], references: [id])
}

// ============================================
// 优惠券模块 (v0.5.5)
// ============================================

// 优惠券类型枚举

enum CouponType {
  PERCENTAGE // 百分比折扣 (如: 20% off)
  FIXED // 固定金额折扣 (如: $10 off)
}

// 优惠券模型

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  description  String?
  type         CouponType
  value        Decimal    @db.Decimal(10, 2) // 折扣值或百分比
  minAmount    Decimal?   @db.Decimal(10, 2) // 最低消费金额
  maxDiscount  Decimal?   @db.Decimal(10, 2) // 最高折扣金额
  maxUses      Int? // 最大使用次数
  usedCount    Int        @default(0)
  perUserLimit Int        @default(1)
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  usages CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
}

// 优惠券使用记录模型

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String
  discount Decimal  @db.Decimal(10, 2) // 实际折扣金额
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  // 防止重复使用
  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
}

// ============================================
// 会员积分模块 (v0.5.5)
// ============================================

// 会员等级枚举

enum MemberTier {
  BRONZE // 青铜
  SILVER // 白银
  GOLD // 黄金
  PLATINUM // 白金
}

// 积分类型枚举

enum PointType {
  EARN // 消费获得
  REDEEM // 兑换抵扣
  BONUS // 奖励
  EXPIRE // 过期作废
  ADJUST // 后台调整
  REFUND // 退款扣回
}

// 积分计划模型

model LoyaltyProgram {
  id            String   @id @default(cuid())
  name          String   @default("默认积分计划")
  pointsRate    Float    @default(1.0) // 每消费1元得积分
  pointsToYuan  Float    @default(0.01) // 100积分=1元
  minRedemption Int      @default(100) // 最低兑换积分
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 客户积分模型

model CustomerPoints {
  id            String     @id @default(cuid())
  userId        String     @unique
  balance       Int        @default(0)
  totalEarned   Int        @default(0)
  totalRedeemed Int        @default(0)
  tier          MemberTier @default(BRONZE)
  updatedAt     DateTime   @updatedAt

  user         User               @relation(fields: [userId], references: [id])
  transactions PointTransaction[]

  @@index([userId])
}

// 积分交易记录模型

model PointTransaction {
  id               String    @id @default(cuid())
  customerPointsId String
  userId           String
  amount           Int // 正数=获得，负数=消耗
  type             PointType
  orderId          String?
  description      String
  expiresAt        DateTime? // 积分过期时间
  createdAt        DateTime  @default(now())

  customerPoints CustomerPoints @relation(fields: [customerPointsId], references: [id])

  @@index([userId])
  @@index([customerPointsId])
  @@index([type])
  @@index([expiresAt])
}

// ============================================
// 废弃购物车模块 (v0.5.8)
// 用于追踪废弃购物车并发送挽回邮件
// ============================================

// 废弃购物车状态枚举

enum AbandonedCartStatus {
  PENDING // 待发送
  SENT // 已发送第一封
  SENT_SECOND // 已发送第二封
  RECOVERED // 已恢复（用户完成购买）
  EXPIRED // 已过期（不再发送）
}

// 废弃购物车模型

model AbandonedCart {
  id          String              @id @default(cuid())
  userId      String
  userEmail   String
  userName    String?
  cartData    Json // 购物车内容
  totalAmount Decimal             @db.Decimal(10, 2) // 使用 Decimal 避免浮点数精度问题
  locale      String              @default("en")
  status      AbandonedCartStatus @default(PENDING)
  lastEmailAt DateTime?
  emailCount  Int                 @default(0)
  recoveredAt DateTime? // 恢复购买时间
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // 复合索引：状态+时间（废弃购物车查询）
  // 复合索引：用户+状态
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([userId, status])
}

// ============================================
// 多币种支持模块 (v0.6.0 P1)
// ============================================

// 货币配置模型

model Currency {
  code      String   @id // ISO 4217 代码 (USD, EUR, GBP, JPY)
  name      String // 货币名称
  symbol    String // 货币符号 ($ , € , £ , ¥)
  decimals  Int      @default(2) // 小数位数
  isDefault Boolean  @default(false) // 是否为默认货币
  isActive  Boolean  @default(true) // 是否启用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exchangeRates ExchangeRate[]
}

// 汇率记录模型

model ExchangeRate {
  id             String   @id @default(cuid())
  baseCurrency   String // 基准货币代码
  targetCurrency String // 目标货币代码
  rate           Decimal  @db.Decimal(12, 6) // 汇率（基准货币 : 目标货币）
  fetchedAt      DateTime @default(now()) // 汇率获取时间
  expiresAt      DateTime // 汇率过期时间
  source         String   @default("exchangerate-api.com") // 汇率数据源

  currency Currency @relation(fields: [baseCurrency], references: [code])

  @@unique([baseCurrency, targetCurrency])
  @@index([baseCurrency])
  @@index([targetCurrency])
  @@index([expiresAt])
}

// 订单多币种记录（用于追踪原始币种和转换后金额）

model OrderCurrency {
  id              String  @id @default(cuid())
  orderId         String  @unique
  baseCurrency    String  @default("USD") // 订单原始币种
  displayCurrency String  @default("USD") // 显示币种
  exchangeRate    Decimal @default(1) @db.Decimal(12, 6) // 结算时的汇率
  baseAmount      Decimal @db.Decimal(10, 2) // 原始金额
  displayAmount   Decimal @db.Decimal(10, 2) // 转换后显示金额

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// ============================================
// 自动化营销序列模块 (v0.6.0 P1)
// ============================================

// 触发器类型枚举

enum TriggerType {
  ORDER_PLACED // 订单创建
  ORDER_PAID // 订单支付
  ORDER_SHIPPED // 订单发货
  ORDER_DELIVERED // 订单送达
  CART_ABANDONED // 购物车废弃
  PRODUCT_VIEWED // 商品浏览
  CUSTOMER_INACTIVE // 客户沉睡
  BIRTHDAY // 生日
  FIRST_PURCHASE // 首次购买
  MEMBERSHIP_TIER // 会员等级变更
}

// 序列状态枚举

enum SequenceStatus {
  DRAFT // 草稿
  ACTIVE // 启用
  PAUSED // 暂停
  COMPLETED // 已完成
}

// 邮件序列模型

model EmailSequence {
  id          String         @id @default(cuid())
  name        String // 序列名称
  description String? // 描述
  trigger     TriggerType // 触发器类型
  status      SequenceStatus @default(DRAFT)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  steps       EmailSequenceStep[]
  enrollments EmailSequenceEnrollment[]

  @@index([trigger])
  @@index([status])
  @@index([isActive])
}

// 邮件序列步骤模型

model EmailSequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  name       String // 步骤名称
  order      Int // 执行顺序
  templateId String // 邮件模板 ID
  delayHours Int      @default(0) // 延迟时间（小时）
  condition  Json? // 触发条件（如：订单金额 > 100）
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
  @@index([order])
  @@index([isActive])
}

// 邮件序列参与记录模型

model EmailSequenceEnrollment {
  id            String           @id @default(cuid())
  sequenceId    String
  userId        String
  currentStep   Int              @default(0) // 当前步骤
  status        EnrollmentStatus @default(ACTIVE)
  enrolledAt    DateTime         @default(now())
  completedAt   DateTime?
  pausedAt      DateTime?
  lastTriggerAt DateTime? // 最后触发时间
  triggerData   Json? // 触发时的数据（如：订单 ID）

  sequence EmailSequence @relation(fields: [sequenceId], references: [id])

  @@unique([sequenceId, userId])
  @@index([sequenceId])
  @@index([userId])
  @@index([status])
}

// 参与状态枚举

enum EnrollmentStatus {
  ACTIVE // 进行中
  COMPLETED // 已完成
  UNENROLLED // 已取消
  FAILED // 失败
  PAUSED // 已暂停
}

// 邮件发送日志模型

model EmailSequenceLog {
  id           String          @id @default(cuid())
  sequenceId   String
  stepId       String
  userId       String
  enrollmentId String
  email        String
  status       EmailSendStatus @default(PENDING)
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  errorMessage String?
  createdAt    DateTime        @default(now())

  @@index([sequenceId])
  @@index([userId])
  @@index([status])
  @@index([sentAt])
}

// 邮件发送状态枚举

enum EmailSendStatus {
  PENDING // 待发送
  SENT // 已发送
  DELIVERED // 已送达
  OPENED // 已打开
  CLICKED // 已点击
  BOUNCED // 退回
  FAILED // 失败
}

// ============================================
// Bundle 套餐销售模块 (v0.6.0 P2)
// ============================================

// 套餐状态枚举

enum BundleStatus {
  DRAFT // 草稿
  ACTIVE // 启用
  INACTIVE // 停用
  ARCHIVED // 已归档
}

// 套餐模型

model Bundle {
  id            String       @id @default(cuid())
  name          String // 套餐名称
  description   String? // 套餐描述
  slug          String       @unique // URL slug
  status        BundleStatus @default(DRAFT)
  discountType  DiscountType // 折扣类型
  discountValue Decimal      @db.Decimal(10, 2) // 折扣值
  startDate     DateTime? // 开始日期
  endDate       DateTime? // 结束日期
  maxUsage      Int? // 最大使用次数
  usedCount     Int          @default(0)
  minItems      Int          @default(2) // 最少商品数
  maxItems      Int? // 最大商品数
  isStackable   Boolean      @default(false) // 是否可与其他优惠叠加
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items BundleItem[]

  @@index([status])
  @@index([slug])
}

// 折扣类型枚举

enum DiscountType {
  PERCENTAGE // 百分比折扣
  FIXED // 固定金额折扣
  BUY_X_GET_Y // 买 X 送 Y
}

// 套餐商品项模型

model BundleItem {
  id            String  @id @default(cuid())
  bundleId      String
  productId     String
  quantity      Int     @default(1) // 套餐中该商品的数量
  isRequired    Boolean @default(true) // 是否必选
  bonusQuantity Int     @default(0) // 赠送数量

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([bundleId, productId])
  @@index([bundleId])
  @@index([productId])
}

// 套餐订单记录模型

model BundleOrder {
  id        String   @id @default(cuid())
  bundleId  String
  orderId   String
  discount  Decimal  @db.Decimal(10, 2) // 实际折扣金额
  createdAt DateTime @default(now())

  @@unique([bundleId, orderId])
  @@index([bundleId])
  @@index([orderId])
}

// ============================================
// 联盟分销系统模块 (v0.6.0 P2)
// ============================================

// 分销商状态枚举

enum AffiliateStatus {
  PENDING // 待审核
  ACTIVE // 启用
  SUSPENDED // 暂停
  REJECTED // 已拒绝
}

// 分销商模型

model Affiliate {
  id             String          @id @default(cuid())
  userId         String          @unique
  status         AffiliateStatus @default(PENDING)
  commissionRate Decimal         @default(10) @db.Decimal(5, 2) // 佣金比例 %
  balance        Decimal         @default(0) @db.Decimal(12, 2) // 可用余额
  totalEarned    Decimal         @default(0) @db.Decimal(12, 2) // 累计收益
  totalPaid      Decimal         @default(0) @db.Decimal(12, 2) // 已支付
  payoutMethod   String? // 支付方式
  payoutInfo     Json? // 支付信息详情
  approvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user        User                  @relation(fields: [userId], references: [id])
  links       AffiliateLink[]
  commissions AffiliateCommission[]
  payouts     AffiliatePayout[]

  @@index([status])
  @@index([userId])
}

// 分销链接模型

model AffiliateLink {
  id          String    @id @default(cuid())
  affiliateId String
  code        String    @unique // 分销码
  productId   String? // 可指定商品
  campaign    String? // 活动名称
  clicks      Int       @default(0)
  conversions Int       @default(0)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  commissions AffiliateCommission[]

  @@index([affiliateId])
  @@index([code])
}

// 佣金记录模型

model AffiliateCommission {
  id          String           @id @default(cuid())
  affiliateId String
  linkId      String
  orderId     String
  userId      String
  amount      Decimal          @db.Decimal(12, 2) // 订单金额
  commission  Decimal          @db.Decimal(12, 2) // 佣金金额
  rate        Decimal          @db.Decimal(5, 2) // 佣金比例
  status      CommissionStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime         @default(now())

  affiliate Affiliate     @relation(fields: [affiliateId], references: [id])
  link      AffiliateLink @relation(fields: [linkId], references: [id])

  @@index([affiliateId])
  @@index([orderId])
  @@index([status])
}

// 佣金状态枚举

enum CommissionStatus {
  PENDING // 待确认
  APPROVED // 已确认
  PAID // 已支付
  CANCELLED // 已取消
  REJECTED // 已拒绝
}

// 佣金提现模型

model AffiliatePayout {
  id            String       @id @default(cuid())
  affiliateId   String
  amount        Decimal      @db.Decimal(12, 2)
  method        String // 支付方式
  status        PayoutStatus @default(PENDING)
  transactionId String? // 外部交易号
  notes         String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([status])
}

// 提现状态枚举

enum PayoutStatus {
  PENDING // 待处理
  PROCESSING // 处理中
  COMPLETED // 已完成
  FAILED // 失败
  CANCELLED // 已取消
}

// ============================================
// 库存预警日志模块 (v0.5.8)
// ============================================

// 库存预警日志模型

model StockAlertLog {
  id             String   @id @default(cuid())
  productId      String
  productName    String
  oldStock       Int
  newStock       Int
  threshold      Int
  notifiedEmails String[]
  createdAt      DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Account recovery audit records store only standardized codes and HMAC fingerprints.
model AccountRecoveryAudit {
  id                 String               @id @default(cuid())
  scope              RecoveryAuditScope
  result             RecoveryAuditResult
  failureCode        RecoveryFailureCode?
  accountFingerprint String
  ipFingerprint      String?
  jobId              String?
  createdAt          DateTime             @default(now())

  @@index([createdAt])
  @@index([scope, result, createdAt])
  @@index([accountFingerprint, createdAt])
  @@index([jobId])
  @@map("account_recovery_audit")
}

enum RecoveryAuditScope {
  USER_PASSWORD_RESET
  ADMIN_PASSWORD_RESET
  ADMIN_DELEGATED_RESET
  ADMIN_EMAIL_CHANGE
  ADMIN_ACTIVATION
  CLI_ADMIN_RECOVERY
}

enum RecoveryAuditResult {
  ACCEPTED
  REJECTED
  FAILED
}

enum RecoveryFailureCode {
  ACCOUNT_NOT_FOUND
  ACCOUNT_SCOPE_MISMATCH
  ACCOUNT_DISABLED
  OTP_INVALID
  OTP_EXPIRED
  OTP_ATTEMPTS_EXHAUSTED
  TOKEN_REPLAYED
  RATE_LIMITED
  DEPENDENCY_UNAVAILABLE
  DELIVERY_NOT_ACCEPTED
}

// ==========================================
// v1.7.2 个人收款码支付方案（临时过渡）
// ==========================================

// ⚠️ v1.7.2 临时方案 - 个人收款码配置
model PaymentQRCode {
  id             String   @id @default(cuid())
  name           String // "支付宝商家收钱码" | "微信个人收款码"
  type           String // "merchant_alipay" | "personal_wechat"
  imageUrl       String // 收款码图片路径
  accountName    String // 收款人姓名
  accountInfo    String? // 账号信息
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  isTempSolution Boolean  @default(true) // 标记为临时方案
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// 支付凭证状态
enum ProofStatus {
  PENDING // 待审核
  OCR_PROCESSING // OCR识别中
  OCR_MATCHED // OCR金额匹配，自动通过
  OCR_MISMATCHED // OCR金额不匹配，需人工审核
  APPROVED // 人工审核通过
  REJECTED // 人工审核拒绝
}

// ⚠️ v1.7.2 临时方案 - 支付凭证（人工审核）
model PaymentProof {
  id            String      @id @default(cuid())
  orderId       String      @unique
  order         Order       @relation(fields: [orderId], references: [id])
  proofImageUrl String // 用户上传的支付截图
  amount        Decimal     @db.Decimal(10, 2)
  paymentMethod String // 支付方式
  status        ProofStatus @default(PENDING)

  // OCR识别结果
  ocrAmount     Decimal?  @db.Decimal(10, 2)
  ocrTimestamp  DateTime?
  ocrConfidence Float?
  ocrRawText    String?

  // 重复检测
  imageHash String

  // 审核字段
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectReason String?

  // 自动删除
  imageDeletedAt DateTime?
  autoDeleteAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([imageHash])
}
