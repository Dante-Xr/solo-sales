  "about": {
    "title": "About Us",
    "description": "Learn about SoloSales brand story and mission",
    "intro": "SoloSales is an independent e-commerce platform dedicated to providing quality products to consumers worldwide. We curate high-quality, cost-effective products to make every shopping experience delightful.",
    "missionTitle": "Our Mission",
    "missionContent": "Through rigorous product selection and excellent customer service, we provide consumers with a trustworthy shopping experience. We believe great products shouldn't be expensive, and quality service shouldn't be complicated.",
    "valuesTitle": "Our Values",
    "value1": "Quality First: Every product is carefully selected",
    "value2": "Customer Centric: Always putting customer needs first",
    "value3": "Integrity: Transparent pricing, authentic reviews"
  },
  "faq": {
    "title": "FAQ",
    "description": "Find answers to common questions about shopping",
    "q1": "How do I track my order?",
    "a1": "After placing an order, you can check order status and shipping information on the 'My Orders' page. Once shipped, we will email you the tracking number.",
    "q2": "What payment methods are supported?",
    "a2": "We support credit cards (Visa, MasterCard), PayPal, and other payment methods. All payments are processed through encrypted channels to ensure your financial security.",
    "q3": "What is the return policy?",
    "a3": "We offer a 7-day no-reason return service. Items must be in original packaging and in resellable condition. Return shipping is borne by the buyer unless the item has quality issues.",
    "q4": "How long does shipping take?",
    "a4": "Domestic orders typically arrive within 3-5 business days, international orders within 7-15 business days. Exact timing depends on your delivery address and shipping method.",
    "q5": "How do I contact customer service?",
    "a5": "You can contact us via the email at the bottom of the page, or find more contact information on the 'About Us' page. We typically respond within 24 hours."
  },
  "privacy": {
    "title": "Privacy Policy",
    "description": "Learn how we protect your personal information",
    "lastUpdated": "Last updated: April 2026",
    "collectTitle": "Information We Collect",
    "collectContent": "We collect information you provide when using our services, including name, contact details, shipping address, and payment information. This information is used solely for order processing and service improvement.",
    "useTitle": "How We Use Information",
    "useContent": "We use your information to process orders, provide customer support, send order updates, and improve our services. We do not sell your personal information to third parties.",
    "cookiesTitle": "Cookie Policy",
    "cookiesContent": "We use cookies to improve your browsing experience, analyze website traffic, and personalize content. You can manage cookie preferences in your browser settings.",
    "rightsTitle": "Your Rights",
    "rightsContent": "Under GDPR and CCPA regulations, you have the right to access, correct, delete your personal data, and to restrict or object to our processing of your data. To exercise these rights, please contact our support team.",
    "contactTitle": "Contact Us",
    "contactContent": "If you have any questions about our privacy policy, please contact us at support@solosales.com."
  },
